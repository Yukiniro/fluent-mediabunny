{
  "name": "fluent-mediabunny",
  "version": "0.2.0",
  "description": "A simpler, more approachable fluent TypeScript API for Mediabunny.",
  "homepage": "https://github.com/Yukiniro/fluent-mediabunny#readme",
  "bugs": {
    "url": "https://github.com/Yukiniro/fluent-mediabunny/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yukiniro/fluent-mediabunny.git"
  },
  "files": [
    "dist",
    "docs",
    "spec",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp dev --host 127.0.0.1",
    "test": "vp test run",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "test:watch": "vp test",
    "format": "vp fmt",
    "type-check": "vp check",
    "test:browser": "playwright test",
    "fixtures": "node scripts/fixtures.mjs",
    "test:package": "vp exec tsc -p tsconfig.package.json"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "1.58.2",
    "@types/node": "^26.6.5",
    "@types/wicg-file-system-access": "2023.10.7",
    "mediabunny": "1.61.6",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "mediabunny": "1.61.6"
  },
  "packageManager": "pnpm@12.14.0"
}
