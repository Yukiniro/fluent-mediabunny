{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fluent-mediabunny-docs",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./doc_build",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // `wrangler preview` refuses to run unless this block exists. Assets and
  // compatibility settings stay at the top level; an empty block is valid.
  "previews": {},
}
